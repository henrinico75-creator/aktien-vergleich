# Kopie als .env anlegen, dann Werte eintragen. .env ist in .gitignore.

# Optional: strukturierte Fundamentaldaten-API als Ergaenzung zu yfinance.
# Kostenlose Kontingente beachten.
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# Basis-URL der veroeffentlichten Seite, ueberschreibt config.yaml.
# Auf Vercel als Environment Variable des Projekts setzen (Projekt-Domain
# oder eigene Domain). Leer lassen heisst: Wert aus config.yaml.
SITE_BASE_URL=

# Pfad-Prefix fuer Links und Assets innerhalb der Seiten, ueberschreibt
# config.yaml. Auf Vercel leer lassen (Auslieferung von der Domain-Wurzel).
SITE_PATH_PREFIX=

# Optional: eigene Meldungs-Zusammenfassungen (src/summarize.py).
ANTHROPIC_API_KEY=

# Optional: Bildgenerierung ueber Google Gemini "Nano Banana"
# (src/images.py). Schluessel aus Google AI Studio. Ohne Schluessel
# passiert nichts.
GEMINI_API_KEY=
# Modell ueberschreiben, Vorgabe: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
