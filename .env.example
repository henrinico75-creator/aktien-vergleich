# Kopie als .env anlegen, dann Werte eintragen. .env ist in .gitignore.

# Optional: strukturierte Fundamentaldaten-API als Ergaenzung zu yfinance.
# Kostenlose Kontingente beachten.
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# Basis-URL der veroeffentlichten Seite, ueberschreibt config.yaml.
# Leer lassen heisst: Wert aus config.yaml wird genutzt.
SITE_BASE_URL=

# Pfad-Prefix fuer Links und Assets innerhalb der Seiten, ueberschreibt
# config.yaml. Lokal leer lassen. Auf GitHub Project Pages der Repo-Name.
SITE_PATH_PREFIX=
